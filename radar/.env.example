# Gridiron Locker Radar — environment secrets
# ---------------------------------------------------------------------------
# Copy to .env (never commit .env). On Vercel/Render/Railway set these in the
# dashboard → Environment Variables (all server-side, never NEXT_PUBLIC_).
#
# Generate a bcrypt hash:  node -e "import('bcryptjs').then(m=>m.hash('your-password',10).then(h=>console.log(h)))"
# Generate a session secret:  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Authentication (hard requirement per spec §3) ---
# One owner/operator account. More users can be added as JSON array in RADAR_USERS.
RADAR_AUTH_USER=owner
# bcrypt hash of the owner's password (NOT plaintext). Example hash for "gridiron-radar-2026" (replace immediately):
RADAR_AUTH_PASSWORD_HASH=$2a$10$exampleReplaceme.hash.notrealDoNotUse
# 32+ byte random secret for signing session cookies / JWTs
RADAR_SESSION_SECRET=replace_with_openssl_rand_hex_32

# Optional: additional operators (JSON array). Each entry needs user + bcrypt hash.
# RADAR_USERS=[{"user":"ops","hash":"$2a$10$..."}]

# --- App ---
NODE_ENV=production
PORT=3001
# Public origin where Radar is deployed (for cookies, CORS, absolute URLs)
RADAR_ORIGIN=https://radar.gridironlocker.store
# Where public storefront lives (for approved-product promotion links)
PUBLIC_STORE_ORIGIN=https://gridironlocker.store

# --- Data persistence ---
# Radar stores intelligence locally as JSON (designed for Postgres later).
# On Vercel use /tmp or an attached volume; set RADAR_DATA_DIR accordingly.
RADAR_DATA_DIR=./data

# --- Optional connectors (all respect rate limits / terms) ---
# Add these ONLY if you have legitimate API access. Radar degrades gracefully
# without them — confidence is capped (fan_reaction ≤6) when disconnected.
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- GitHub ---
GITHUB_TOKEN=

# --- Customer Intent Finder (/private/customer-finder/) ---
# Every "FIND NEW BUYERS" press calls these live. More connectors = more coverage.
# Reddit: free "script" app at https://www.reddit.com/prefs/apps (REDDIT_CLIENT_ID/SECRET above).
#   Without it, the finder falls back to Reddit's public JSON (low rate limit). CF_REDDIT_PUBLIC_JSON=0 disables that.
# X: X_BEARER_TOKEN above (API Basic tier or higher — recent search).
# Web + public forums + indexed public Facebook/Quora threads:
BRAVE_SEARCH_API_KEY=
# Bluesky (the public search endpoint may require an account; use an app password, not your main password):
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Optional tuning
# CF_MAX_AGE_DAYS=45          # ignore posts older than this
# CF_MAX_FOLLOWERS=20000      # skip X accounts larger than this (influencers)
# CF_WEB_QUERIES=10           # web-search phrases per press (cost control)
# CF_LEMMY=1  CF_LEMMY_INSTANCE=lemmy.world
# CF_DB_FILE=/data/customer-finder.db   # defaults to $RADAR_DATA_DIR/customer-finder.db
