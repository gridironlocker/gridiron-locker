# Python bytecode / caches
# (the daily refresh workflow does `git add -A`, so keep these out of the repo)
__pycache__/
*.py[cod]
.venv/

# Local file:// copy built by src/make_offline.py - a ~79MB duplicate of site/
# that is never deployed. The refresh workflow's `git add -A` would otherwise
# commit it on any machine that has run make_offline.py.
site-offline/

# Local dry-run/live publishing results; the pulse itself is the reviewed input.
marketing/publish-results.json
site/marketing/publish-results.json

# PRIVATE OSINT prospect engine state — NEVER commit prospect data.
# The refresh workflow commits with `git add -A`, so this guard is load-bearing.
# Collected contact data is sensitive marketing data (see marketing/osint/README.md).
marketing/osint/state/
marketing/osint/exports/
*.prospects.db
# Defence in depth: even if private state were ever copied into the site
# mirror by hand (sync_marketing/sync_ops already exclude it), `git add -A`
# must still refuse it. No tracked file matches these patterns (audit.py
# verifies), so the rules only ever bite on leaks.
*.db
suppression.csv
gridiron_prospects_*.csv
high_priority_contacts_*.csv
site/marketing/osint/state/
site/marketing/osint/exports/


